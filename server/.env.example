# server/.env.example
# 이 파일을 server/.env로 복사한 뒤 실제 값을 채운다 (docker-compose가 자동으로 읽는다).
# .env 자체는 .gitignore에 등록돼 있어 git에 올라가지 않는다.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=RottenNobleDB
DB_USER=root
DB_PASS=

# openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

ADMIN_USERNAME=admin
# 기존 backend/config.local.php의 admin_password_hash 값을 그대로 재사용할 수 있다
# (password_hash()가 만든 bcrypt 해시 — BCryptPasswordEncoder가 그대로 검증한다).
ADMIN_PASSWORD_HASH=

CORS_ALLOWED_ORIGINS=https://rotten-noble.com,https://www.rotten-noble.com,http://localhost:5173
