# deploy.sh가 읽는 실제 값 파일은 .env.prod (git 추적 안 됨, NAS에서 직접 채운다).
# 기존 backend/config.local.php(NAS, /volume1/web/rotten-noble/backend/config.local.php)에
# 이미 있는 값을 그대로 옮기면 된다 — 새로 만드는 값이 아니다.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# 컨테이너가 bridge 네트워크라 127.0.0.1은 컨테이너 자신을 가리킨다 — NAS 자체 LAN IP를 쓴다.
DB_HOST=192.168.50.2
DB_PORT=3306
DB_NAME=RottenNobleDB
DB_USER=root
DB_PASSWORD=

REDIS_HOST=192.168.50.2
REDIS_PORT=6379

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
